  "components": {
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "user",
          "pass"
        ],
        "properties": {
          "user": {
            "type": "string"
          },
          "pass": {
            "type": "string"
          }
        }
      },
      "LoginSuccessResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "认证令牌 (JWT)"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer"
              },
              "username": {
                "type": "string"
              },
              "role": {
                "type": "string"
              }
            }
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "token",
          "user",
          "pass"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "从 GET /system/setup 获取的安装令牌"
          },
          "user": {
            "type": "string",
            "description": "新管理员的用户名"
          },
          "pass": {
            "type": "string",
            "description": "新管理员的密码"
          }
        }
      },
      "SchemaResult": {
        "type": "object",
        "description": "数据模式的表示。这是一个基于 Protobuf `SchemaResult` 的推断结构。",
        "properties": {
          "tableSchemas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tableName": {
                  "type": "string"
                },
                "columns": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "type": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "ViewConfig": {
        "type": "object",
        "description": "用于控制前端UI如何展示数据的配置",
        "properties": {
          "id": {
            "type": "string"
          },
          "bizName": {
            "type": "string"
          },
          "tableName": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "description": "视图名称"
          },
          "isDefault": {
            "type": "boolean",
            "description": "是否为默认视图"
          },
          "type": {
            "type": "string",
            "enum": [
              "table",
              "card"
            ],
            "description": "视图类型"
          },
          "fieldSettings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "fieldName": {
                  "type": "string"
                },
                "label": {
                  "type": "string",
                  "description": "字段显示标签"
                },
                "visible": {
                  "type": "boolean",
                  "description": "是否可见"
                },
                "order": {
                  "type": "integer",
                  "description": "显示顺序"
                }
              }
            }
          }
        }
      },
      "DataQueryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "查询结果，结构可变",
            "additionalProperties": true
          },
          "source": {
            "type": "string",
            "description": "数据源类型"
          }
        }
      },
      "DataMutateResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "description": "变更结果，结构可变",
            "additionalProperties": true
          },
          "source": {
            "type": "string",
            "description": "数据源类型"
          }
        }
      },
      "PluginManifest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "versions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PluginInstance": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "pluginId": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "bizName": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "BizQueryConfig": {
        "type": "object",
        "properties": {
          "bizName": {
            "type": "string"
          },
          "settings": {
            "$ref": "#/components/schemas/BizOverallSettings"
          },
          "searchableTables": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tables": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/TableConfig"
            }
          }
        }
      },
      "BizOverallSettings": {
        "type": "object",
        "properties": {
          "displayName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "TableConfig": {
        "type": "object",
        "properties": {
          "fieldSettings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldSetting"
            }
          },
          "allowCreate": {
            "type": "boolean"
          },
          "allowUpdate": {
            "type": "boolean"
          },
          "allowDelete": {
            "type": "boolean"
          }
        }
      },
      "FieldSetting": {
        "type": "object",
        "properties": {
          "fieldName": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "isSearchable": {
            "type": "boolean"
          },
          "isSortable": {
            "type": "boolean"
          }
        }
      },
      "TablePermissions": {
        "type": "object",
        "properties": {
          "allow_create": {
            "type": "boolean"
          },
          "allow_update": {
            "type": "boolean"
          },
          "allow_delete": {
            "type": "boolean"
          }
        }
      },
      "BizRateLimitSetting": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "rate": {
            "type": "number",
            "description": "每秒请求数"
          },
          "burst": {
            "type": "integer",
            "description": "令牌桶大小"
          }
        }
      },
      "IPLimitSetting": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "rate": {
            "type": "number",
            "description": "每秒请求数"
          },
          "burst": {
            "type": "integer",
            "description": "令牌桶大小"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "错误信息"
          }
        }
      },
      "SuccessMessageResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "SuccessStatusResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          }
        }
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "需要认证",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "需要认证"
            }
          }
        }
      },
      "ForbiddenError": {
        "description": "需要管理员权限",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "需要管理员权限"
            }
          }
        }
      },
      "NotFoundError": {
        "description": "资源未找到",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "error": "未找到业务"
            }
          }
        }
      },
      "SuccessMessageResponse": {
        "description": "操作成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SuccessMessageResponse"
            }
          }
        }
      },
      "SuccessStatusResponse": {
        "description": "操作成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/SuccessStatusResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
